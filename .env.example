# Deployment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED: Deployment Credentials
# =============================================================================

# Private key of the deployer account (without 0x prefix)
PRIVATE_KEY=

# Address that will own the contract (receives fees, can adjust fee amount)
OWNER_ADDRESS=

# =============================================================================
# OPTIONAL: Contract Configuration
# =============================================================================

# Initial fee to attach a note (in wei)
# Default: 100000000000000 (0.0001 ETH)
# INITIAL_FEE=100000000000000

# =============================================================================
# NETWORK: RPC URLs
# =============================================================================

# Base Mainnet
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Base Sepolia Testnet
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# =============================================================================
# VERIFICATION: Basescan API Key
# =============================================================================

# Get your API key from https://basescan.org/myapikey
BASESCAN_API_KEY=
